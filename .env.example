# =============================================================================
# goNuts environment configuration — copy to ".env" and fill in real values.
# These are read by core/settings.py via os.environ. Do NOT commit your .env.
# =============================================================================

# --- Core security ---------------------------------------------------------
# Generate a fresh one, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# The old key that was committed to git is COMPROMISED — rotate it here.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-secret

# Keep this False (or unset) in production. Set to 1/true only for local dev.
DJANGO_DEBUG=0

# Comma-separated hostnames Django will serve.
DJANGO_ALLOWED_HOSTS=gonut.click,www.gonut.click,localhost,127.0.0.1

# Comma-separated origins (with scheme) allowed to submit forms / CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=https://gonut.click,https://www.gonut.click

# --- HTTPS / headers (only applied when DJANGO_DEBUG is off) ----------------
# Set to 0 if your proxy/load balancer already forces HTTPS and you hit
# redirect loops; otherwise leave on.
DJANGO_SECURE_SSL_REDIRECT=1
# HSTS max-age in seconds (default 1 year). Set to 0 to disable while testing.
DJANGO_HSTS_SECONDS=31536000
